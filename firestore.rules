rules_version = '2';

// Who can do what in the database.
//   Admin   : read everything, change items, groups and dates.
//   Checker : read items, groups and dates. Cannot change them.
// Roles live in users/{uid}.role and are set by you in the Firebase console,
// so nobody can make themselves an admin from the app.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function role() { return exists(me()) ? get(me()).data.role : ''; }
    function isStaff() { return signedIn() && role() in ['admin', 'checker']; }
    function isAdmin() { return signedIn() && role() == 'admin'; }

    // The admin can add and remove checkers from the app, but can never make
    // anyone an admin. Admins are only made in the Firebase console.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'role', 'email'])
        && request.resource.data.role == 'checker'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60;
      allow delete: if isAdmin() && resource.data.role == 'checker';
      allow update: if false;
    }

    match /items/{id} {
      allow read: if isStaff();
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.unit is string
        && request.resource.data.a is number && request.resource.data.a >= 0
        && request.resource.data.b is number && request.resource.data.b >= 0;
      allow delete: if isAdmin();
    }

    match /groups/{id} {
      allow read: if isStaff();
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.extraDays is number
        && request.resource.data.extraDays >= 0
        && request.resource.data.rules is map;
      allow delete: if isAdmin();
    }

    // One document per date, id "YYYY-MM-DD", so a date can only have one group.
    match /dates/{day} {
      allow read: if isStaff();
      allow create, update: if isAdmin()
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.group is string;
      allow delete: if isAdmin();
    }
  
    // One stock check per block, named by the block's first day.
    // Checkers fill it in while it is a draft. Once submitted, only the
    // admin can change it (report seen, invoice). The server adds reminder
    // flags with its own key, which skips these rules.
    match /checks/{block} {
      allow read: if isStaff();
      allow create: if isStaff()
        && block.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.status in ['draft', 'submitted']
        && request.resource.data.counts is map;
      allow update: if isAdmin() || (isStaff()
        && resource.data.status == 'draft'
        && request.resource.data.status in ['draft', 'submitted']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['counts', 'status', 'lines', 'by', 'byName', 'submittedAt', 'updatedAt', 'type', 'days', 'start']));
      allow delete: if isAdmin();
    }

    // Invoice photo and what was read from it. Admin only.
    match /invoices/{block} {
      allow read, write: if isAdmin();
    }

    // Phones that asked for notifications. Each person manages only their own.
    match /tokens/{token} {
      allow read: if signedIn() && (resource == null || resource.data.uid == request.auth.uid);
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
