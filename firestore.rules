rules_version = '2';

// Who can do what in the database.
//   Admin   : read everything, change items, groups, checkers and invoices.
//   Checker : read items and groups, fill in the stock check until it is submitted.
// Roles live in users/{uid}.role. Admins are only made in the Firebase console.
//
// Collections:
//   users/{uid}            name, email, role
//   users/{uid}/phones/{x} phones that turned notifications on
//   items/{onions}         name, unit, wedFri, satTue, onlyFor (group id, optional)
//   groups/{diwali}        name, multiply, dates [..], custom { itemId: {...} }
//   checks/{2026-10-07}    one stock check per block (named by its first day)
//   invoices/{2026-10-07}  the invoice photo for that check
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function role() { return exists(me()) ? get(me()).data.role : ''; }
    function isStaff() { return signedIn() && role() in ['admin', 'checker']; }
    function isAdmin() { return signedIn() && role() == 'admin'; }
    function isDay(s) { return s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // the admin can add and remove checkers, never make another admin
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'role', 'email'])
        && request.resource.data.role == 'checker'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60;
      allow delete: if isAdmin() && resource.data.role == 'checker';
      allow update: if false;

      match /phones/{phone} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    match /items/{id} {
      allow read: if isStaff();
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.unit is string
        && request.resource.data.wedFri is number && request.resource.data.wedFri >= 0
        && request.resource.data.satTue is number && request.resource.data.satTue >= 0;
      allow delete: if isAdmin();
    }

    match /groups/{id} {
      allow read: if isStaff();
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.multiply is number
        && request.resource.data.multiply > 0
        && request.resource.data.dates is list
        && request.resource.data.custom is map;
      allow delete: if isAdmin();
    }

    // Checkers fill this in while counting. Once submitted only the admin can
    // change it (report seen, invoice). The server adds reminder notes with its
    // own key, which skips these rules.
    match /checks/{block} {
      allow read: if isStaff();
      allow create: if isStaff() && isDay(block)
        && request.resource.data.status in ['counting', 'submitted']
        && request.resource.data.items is map;
      allow update: if isAdmin() || (isStaff()
        && resource.data.get('status', 'counting') != 'submitted'
        && request.resource.data.status in ['counting', 'submitted']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['items', 'status', 'start', 'block', 'days', 'checkedBy', 'checkedByUid', 'submittedAt', 'updatedAt']));
      allow delete: if isAdmin();
    }

    match /invoices/{block} {
      allow read, write: if isAdmin();
    }

    // Old layout from the first version. Only here so the admin's
    // "Clean up old data" button can delete it. Safe to remove later.
    match /dates/{x}     { allow read, delete: if isAdmin(); }
    match /reminders/{x} { allow read, delete: if isAdmin(); }
    match /tokens/{x}    { allow read, delete: if isAdmin(); }
  }
}
